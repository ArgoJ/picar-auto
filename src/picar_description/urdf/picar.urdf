<?xml version="1.0"?>
<!--
  picar.urdf - Grundgeruest fuer den PiCar-Roboter (aktuell ohne Roboterarm)

  Koordinatenkonvention (ROS REP-103):
    +X = vorwaerts, +Y = links, +Z = oben
    base_link = [0, 0, 0] (Car-Ursprung, abgestimmt auf arm_mpc.py)

  Hinweis: Die Abmessungen [m] und Offsets sind erste Platzhalter-Werte und
  sollten nach dem Ausmessen am realen Fahrzeug angepasst werden.
-->
<robot name="picar">

  <!-- Materialien fuer Visualisierung (Foxglove / RViz) -->
  <material name="dark_gray">
    <color rgba="0.2 0.2 0.22 1.0"/>
  </material>
  <material name="tire_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>
  <material name="servo_blue">
    <color rgba="0.15 0.45 0.85 1.0"/>
  </material>
  <material name="metal_silver">
    <color rgba="0.72 0.75 0.78 1.0"/>
  </material>
  <material name="pcb_green">
    <color rgba="0.1 0.55 0.25 1.0"/>
  </material>
  <material name="camera_dark">
    <color rgba="0.12 0.12 0.16 1.0"/>
  </material>

  <!-- Virtueller Ursprung ohne Traegheit (KDL-kompatibel) -->
  <link name="base_link"/>

  <joint name="base_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0.0 0.0 0.04" rpy="0.0 0.0 0.0"/>
  </joint>

  <!-- Haupt-Chassis aus 2 Boxen (z relativ zu chassis_link bei z=0.040 ab Boden):
       - Untere Box: 3..9 cm ueber Boden, x = -0.100 .. +0.125 (3 cm hinter Hinterachse bis 5 cm vor Vorderachs-Drehpunkt)
       - Obere Box:  9..12.5 cm ueber Boden, x = -0.100 .. +0.050 (stoppt 2.5 cm vor Vorderachs-Drehpunkt) -->
  <link name="chassis_link">
    <!-- Untere Chassis-Box -->
    <visual>
      <origin xyz="0.0125 0.0 0.020" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.225 0.100 0.060"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <!-- Obere Chassis-Box -->
    <visual>
      <origin xyz="-0.025 0.0 0.0675" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.150 0.100 0.035"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0.0125 0.0 0.020" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.225 0.100 0.060"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.025 0.0 0.0675" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.150 0.100 0.035"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 0.0375" rpy="0.0 0.0 0.0"/>
      <mass value="1.2"/>
      <inertia ixx="0.00190" ixy="0.0" ixz="0.0" iyy="0.00666" iyz="0.0" izz="0.00676"/>
    </inertial>
  </link>

  <!-- ======================================================================= -->
  <!-- HINTERACHSE: 2 Antriebsraeder (Drehmoment-Inputs fuer DC-Motoren)       -->
  <!-- ======================================================================= -->
  <link name="rear_left_wheel_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="1.57079632679 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.040" length="0.026"/>
      </geometry>
      <material name="tire_black"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="1.57079632679 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.040" length="0.026"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <mass value="0.08"/>
      <inertia ixx="0.0000256" ixy="0.0" ixz="0.0" iyy="0.0000423" iyz="0.0" izz="0.0000256"/>
    </inertial>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="chassis_link"/>
    <child link="rear_left_wheel_link"/>
    <origin xyz="-0.070 0.0825 0.0" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1.5" velocity="15.0"/>
    <dynamics damping="0.02" friction="0.01"/>
  </joint>

  <link name="rear_right_wheel_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="1.57079632679 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.040" length="0.026"/>
      </geometry>
      <material name="tire_black"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="1.57079632679 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.040" length="0.026"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <mass value="0.08"/>
      <inertia ixx="0.0000256" ixy="0.0" ixz="0.0" iyy="0.0000423" iyz="0.0" izz="0.0000256"/>
    </inertial>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="chassis_link"/>
    <child link="rear_right_wheel_link"/>
    <origin xyz="-0.070 -0.0825 0.0" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1.5" velocity="15.0"/>
    <dynamics damping="0.02" friction="0.01"/>
  </joint>

  <!-- ======================================================================= -->
  <!-- VORDERACHSE: Lenkservo (CH0) + Parallel-Lenkstange + Vorderrad-Gelenke  -->
  <!-- ======================================================================= -->
  <link name="steering_servo_horn_link">
    <visual>
      <origin xyz="-0.015 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.036 0.008 0.006"/>
      </geometry>
      <material name="servo_blue"/>
    </visual>
    <inertial>
      <origin xyz="-0.015 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001"/>
    </inertial>
  </link>

  <!-- Aktiver Lenkeingang ueber Drehservo (+/- 40 Grad = +/- 0.698132 rad) -->
  <joint name="steering_servo_joint" type="revolute">
    <parent link="chassis_link"/>
    <child link="steering_servo_horn_link"/>
    <origin xyz="0.075 0.0 0.030" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.698132" upper="0.698132" effort="1.0" velocity="5.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- Parallel-Lenkstange: Gegenrotation (-1 * q) haelt die Stange exakt parallel -->
  <link name="steering_rod_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.006 0.085 0.006"/>
      </geometry>
      <material name="metal_silver"/>
    </visual>
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <mass value="0.02"/>
      <inertia ixx="0.000024" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000024"/>
    </inertial>
  </link>

  <joint name="steering_rod_joint" type="revolute">
    <parent link="steering_servo_horn_link"/>
    <child link="steering_rod_link"/>
    <origin xyz="-0.030 0.0 -0.015" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.698132" upper="0.698132" effort="1.0" velocity="5.0"/>
    <mimic joint="steering_servo_joint" multiplier="-1.0" offset="0.0"/>
  </joint>


  <!-- Linker Achsschenkel (folgt steering_servo_joint 1:1) + linkes Vorderrad -->
  <link name="front_left_knuckle_link">
    <visual>
      <origin xyz="-0.015 0.0 0.0075" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.036 0.010 0.020"/>
      </geometry>
      <material name="metal_silver"/>
    </visual>
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <mass value="0.02"/>
      <inertia ixx="0.000002" ixy="0.0" ixz="0.0" iyy="0.000002" iyz="0.0" izz="0.000002"/>
    </inertial>
  </link>

  <joint name="front_left_steer_joint" type="revolute">
    <parent link="chassis_link"/>
    <child link="front_left_knuckle_link"/>
    <origin xyz="0.075 0.0425 0.0" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.698132" upper="0.698132" effort="1.0" velocity="5.0"/>
    <mimic joint="steering_servo_joint" multiplier="1.0" offset="0.0"/>
  </joint>

  <link name="front_left_wheel_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="1.57079632679 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.040" length="0.026"/>
      </geometry>
      <material name="tire_black"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="1.57079632679 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.040" length="0.026"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <mass value="0.08"/>
      <inertia ixx="0.0000256" ixy="0.0" ixz="0.0" iyy="0.0000423" iyz="0.0" izz="0.0000256"/>
    </inertial>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_knuckle_link"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="-0.005 0.040 0.0" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.005"/>
  </joint>

  <!-- Rechter Achsschenkel (folgt steering_servo_joint 1:1) + rechtes Vorderrad -->
  <link name="front_right_knuckle_link">
    <visual>
      <origin xyz="-0.015 0.0 0.0075" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.036 0.010 0.020"/>
      </geometry>
      <material name="metal_silver"/>
    </visual>
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <mass value="0.02"/>
      <inertia ixx="0.000002" ixy="0.0" ixz="0.0" iyy="0.000002" iyz="0.0" izz="0.000002"/>
    </inertial>
  </link>

  <joint name="front_right_steer_joint" type="revolute">
    <parent link="chassis_link"/>
    <child link="front_right_knuckle_link"/>
    <origin xyz="0.075 -0.0425 0.0" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.698132" upper="0.698132" effort="1.0" velocity="5.0"/>
    <mimic joint="steering_servo_joint" multiplier="1.0" offset="0.0"/>
  </joint>

  <link name="front_right_wheel_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="1.57079632679 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.040" length="0.026"/>
      </geometry>
      <material name="tire_black"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="1.57079632679 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.040" length="0.026"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <mass value="0.08"/>
      <inertia ixx="0.0000256" ixy="0.0" ixz="0.0" iyy="0.0000423" iyz="0.0" izz="0.0000256"/>
    </inertial>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_knuckle_link"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="-0.005 -0.040 0.0" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.005"/>
  </joint>

  <!-- ======================================================================= -->
  <!-- SENSOREN: MPU6050 IMU & untere Kamera (90-Grad-Hochkant-Montage)        -->
  <!-- ======================================================================= -->
  <link name="imu_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.020 0.015 0.004"/>
      </geometry>
      <material name="pcb_green"/>
    </visual>
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <mass value="0.005"/>
      <inertia ixx="0.0000002" ixy="0.0" ixz="0.0" iyy="0.0000002" iyz="0.0" izz="0.0000002"/>
    </inertial>
  </link>

  <!-- 5 cm vor Hinterachse (-0.070 + 0.050), 0.3 cm rechts (-0.003), 10 cm ueber Boden (0.100 - 0.040) -->
  <!-- TODO: rpy anhand der X/Y-Pfeile auf dem Modul bzw. Kipptest anpassen -->
  <joint name="imu_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.020 -0.003 0.060" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.012 0.025 0.024"/>
      </geometry>
      <material name="camera_dark"/>
    </visual>
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <mass value="0.015"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001"/>
    </inertial>
  </link>

  <!-- Untere Frontkamera mit +90 Grad Roll (roll = +pi/2); 4.8 cm vor Vorderachs-Drehpunkt (0.075 + 0.048) -->
  <joint name="camera_mount_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="camera_link"/>
    <origin xyz="0.123 0.0 0.045" rpy="1.57079632679 0.0 0.0"/>
  </joint>

  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0.0 0.0 0.0" rpy="-1.57079632679 0.0 -1.57079632679"/>
  </joint>

  <!-- ======================================================================= -->
  <!-- MOTOR-/TORQUE- & LENKUNGSSCHNITTSTELLEN (ros2_control / Simulation)     -->
  <!-- ======================================================================= -->
  <ros2_control name="picar_base_system" type="system">
    <hardware>
      <plugin>picar_hardware/PiCarSystemInterface</plugin>
    </hardware>
    <joint name="rear_left_wheel_joint">
      <command_interface name="effort">
        <param name="min">-1.5</param>
        <param name="max">1.5</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="effort">
        <param name="min">-1.5</param>
        <param name="max">1.5</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="steering_servo_joint">
      <command_interface name="position">
        <param name="min">-0.698132</param>
        <param name="max">0.698132</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1.0</param>
        <param name="max">1.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

</robot>
